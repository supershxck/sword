/* Glamdring — used-future retro command aesthetic */

Screen {
    background: #05080f;
    color: #4ade80;
}

#texture {
    layer: background;
    width: 100%;
    height: 100%;
    color: #0c1520 35%;
    overflow: hidden;
}

Header {
    background: #070d16;
    color: #22d3ee;
    border-bottom: tall #0891b2;
    text-style: bold;
}

Footer {
    background: #070d16;
    color: #64748b;
    border-top: tall #0e3a4a;
}

#title-bar {
    text-align: center;
    text-style: bold;
    color: #22d3ee;
    background: #080f18;
    padding: 1 0;
    border: solid #0891b2;
    margin: 0 1 0 1;
}

#subtitle-bar {
    text-align: center;
    color: #64748b;
    padding: 0 0 1 0;
    margin: 0 2;
}

#telemetry {
    height: auto;
    margin: 0 1 1 1;
    layout: horizontal;
    height: 11;
}

.gauge {
    width: 1fr;
    height: 100%;
    margin: 0 1 0 0;
    content-align: center middle;
}

.gpu-panel {
    width: 2fr;
    height: 100%;
    border: solid #0891b2;
    background: #0a1219;
    padding: 0 1;
    content-align: left middle;
}

#command-deck {
    height: 1fr;
    margin: 0 1 1 1;
}

#neglect, #forge {
    width: 1fr;
    height: 100%;
    border: solid #0891b2;
    background: #0a1219;
    margin: 0 1 0 0;
    padding: 0 1;
}

#ops-deck {
    height: 14;
    margin: 0 1 1 1;
}

#docker, #signals {
    width: 1fr;
    height: 100%;
    border: solid #0891b2;
    background: #0a1219;
    margin: 0 1 0 0;
    padding: 0 1;
}

NeglectRadarPanel, ForgePanel, DockerFleetPanel, SignalLogPanel {
    border: solid #0891b2;
    background: #0a1219;
}

DataTable {
    height: 100%;
    background: #080f18;
    color: #4ade80;
}

DataTable > .datatable--header {
    background: #0c1824;
    color: #22d3ee;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: #0e3a4a 60%;
    color: #4ade80;
}

DataTable > .datatable--odd-row {
    background: #070d14;
}

DataTable > .datatable--even-row {
    background: #0a1219;
}

Static {
    background: transparent;
}
